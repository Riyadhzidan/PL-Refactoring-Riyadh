<!DOCTYPE html>
<html>

<head>
    <title>Edit Mahasiswa</title>
</head>

<body>

    <h1>Edit Mahasiswa</h1>

    <form action="/edit/<%= student.id %>" method="POST">

        <input type="text" name="name" value="<%= student.name %>">

        <br><br>

        <input type="text" name="major" value="<%= student.major %>">

        <br><br>

        <button type="submit">
            Update
        </button>

    </form>

</body>

</html>